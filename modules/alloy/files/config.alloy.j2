// {{ buckle_managed }}
// Host: {{ host.id }}

// ── Logs ─────────────────────────────────────────────────────────────────────

loki.write "grafana_loki" {
  endpoint {
    url = "{{ vars.o11y_loki_url }}"
  }
{%- if vars.o11y_external_labels %}

  external_labels = {
{%- for key, value in vars.o11y_external_labels | items %}
    {{ key }} = "{{ value }}",
{%- endfor %}
  }
{%- endif %}
}

local.file_match "local_files" {
  path_targets = [
{%- for path in vars.o11y_log_paths %}
    {"__path__" = "{{ path }}"},
{%- endfor %}
  ]
  sync_period = "5s"
}

loki.source.file "log_scrape" {
  targets       = local.file_match.local_files.targets
  forward_to    = [loki.process.log_scrape.receiver]
  tail_from_end = true
}

loki.process "log_scrape" {
  forward_to = [loki.write.grafana_loki.receiver]

  stage.static_labels {
    values = {
      hostname = "{{ host.id }}",
    }
  }
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }

  rule {
    source_labels = ["__journal__hostname"]
    target_label  = "hostname"
  }
}

loki.source.journal "log_syslog" {
  format_as_json = true
  relabel_rules  = loki.relabel.journal.rules
  forward_to     = [loki.write.grafana_loki.receiver]
}

// ── Metrics ──────────────────────────────────────────────────────────────────

prometheus.remote_write "mimir" {
  endpoint {
    url = "{{ vars.o11y_mimir_url }}"
  }
}

// The embedded node_exporter, labelled like the standalone one it replaces.
{%- if vars.o11y_textfile_dir %}
// Its textfile collector picks up what other modules write as .prom files
// (ptp-server's time-metrics).
prometheus.exporter.unix "node" {
  textfile {
    directory = "{{ vars.o11y_textfile_dir }}"
  }
}
{%- else %}
prometheus.exporter.unix "node" { }
{%- endif %}

discovery.relabel "node" {
  targets = prometheus.exporter.unix.node.targets

  rule {
    target_label = "instance"
    replacement  = "{{ host.id }}:9100"
  }
}

prometheus.scrape "node_exporter" {
  job_name   = "node_exporter"
  targets    = discovery.relabel.node.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}
{% for scrape in vars.o11y_local_scrapes %}
prometheus.scrape "{{ scrape.job }}" {
  job_name = "{{ scrape.job }}"
  targets  = [
    {"__address__" = "127.0.0.1:{{ scrape.port }}", "instance" = "{{ host.id }}:{{ scrape.port }}"
{%- if scrape.labels is defined %}{% for key, value in scrape.labels | items %}, "{{ key }}" = "{{ value }}"{% endfor %}{% endif %}},
  ]
{%- if scrape.path is defined %}
  metrics_path = "{{ scrape.path }}"
{%- endif %}
{%- if scrape.honor_labels is defined and scrape.honor_labels %}
  honor_labels = true
{%- endif %}
  forward_to = [prometheus.remote_write.mimir.receiver]
}
{% endfor %}
{%- for scrape in vars.o11y_remote_scrapes %}
prometheus.scrape "{{ scrape.name }}" {
  job_name = "{{ scrape.job }}"
  targets  = [
{%- for target in scrape.targets %}
    {"__address__" = "{{ target }}"},
{%- endfor %}
  ]
{%- if scrape.path is defined %}
  metrics_path = "{{ scrape.path }}"
{%- endif %}
{%- if scrape.params is defined %}
  params = {
{%- for key, values in scrape.params | items %}
    "{{ key }}" = {{ values | to_json }},
{%- endfor %}
  }
{%- endif %}
  forward_to = [prometheus.remote_write.mimir.receiver]
}
{% endfor %}
{%- if vars.o11y_probes %}
// ── Black-box probes: the availability SLIs of the homelab's services ────────
// probe_success{job="blackbox", service, probe} every 30 s. Grafana Cloud
// records them into its own Prometheus, where the SLO plugin reads them
// (SpechtLabs/k8s-deployment, grafana/slos/).

prometheus.exporter.blackbox "probes" {
  config = `
modules:
  http_2xx:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
  http_oidc_discovery:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      fail_if_body_not_matches_regexp: ['"issuer"']
  # The API server answers but needs credentials (k3s: no anonymous auth): a
  # 401 proves it is up, serving TLS and authenticating.
  http_401_insecure:
    prober: http
    timeout: 10s
    http:
      preferred_ip_protocol: ip4
      valid_status_codes: [401]
      tls_config:
        insecure_skip_verify: true
`
{%- for probe in vars.o11y_probes %}

  target {
    name    = "{{ probe.name }}"
    address = "{{ probe.url }}"
    module  = "{{ probe.module }}"
    labels  = {"service" = "{{ probe.service }}"}
  }
{%- endfor %}
}

// The exporter names each target's job integrations/blackbox/<name>, which
// wins over job_name below: one job "blackbox" instead, the probe name in
// "probe", and the prober as instance.
discovery.relabel "probes" {
  targets = prometheus.exporter.blackbox.probes.targets

  rule {
    source_labels = ["__param_target"]
    target_label  = "target"
  }
  rule {
    source_labels = ["job"]
    regex         = "integrations/blackbox/(.*)"
    target_label  = "probe"
  }
  rule {
    target_label = "job"
    replacement  = "blackbox"
  }
  rule {
    target_label = "instance"
    replacement  = "{{ host.id }}"
  }
}

prometheus.scrape "probes" {
  job_name        = "blackbox"
  targets         = discovery.relabel.probes.output
  scrape_interval = "30s"
  scrape_timeout  = "15s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}
{%- endif %}
prometheus.exporter.self "self" { }

prometheus.scrape "self" {
  targets    = prometheus.exporter.self.self.targets
  forward_to = [prometheus.remote_write.mimir.receiver]
}
{%- if vars.o11y_otlp_receiver %}

// ── OTLP from the cluster ────────────────────────────────────────────────────

otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    metrics = [otelcol.exporter.prometheus.to_mimir.input]
    logs    = [otelcol.exporter.loki.to_loki.input]
    traces  = [otelcol.exporter.otlphttp.tempo.input]
  }
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = "{{ vars.o11y_tempo_url }}"
  }
}

otelcol.exporter.prometheus "to_mimir" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

otelcol.exporter.loki "to_loki" {
  forward_to = [loki.write.grafana_loki.receiver]
}
{%- endif %}
