# {{ buckle_managed }}
server: https://{{ vars.k3s_server }}:{{ vars.k3s_api_port }}
token: "{{ secrets.K3S_TOKEN }}"
data-dir: /var/lib/rancher/k3s
# Over the tailnet like the server (see its config.yaml): ips[0] is the
# node's tailnet IPv4.
node-ip: {{ host.facts.tailscale.ips[0] }}
flannel-iface: tailscale0
