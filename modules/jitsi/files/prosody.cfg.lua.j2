-- We need this for prosody 13.0
component_admins_as_room_owners = true

plugin_paths = { "/usr/share/jitsi-meet/prosody-plugins/" }

-- domain mapper options, must at least have domain base set to use the mapper
muc_mapper_domain_base = "{{ vars.jitsi_domain }}";

external_service_secret = "{{ secrets.JITSI_TURN_SECRET }}";
external_services = {
     { type = "stun", host = "{{ vars.jitsi_domain }}", port = 3478 },
     { type = "turn", host = "{{ vars.jitsi_domain }}", port = 3478, transport = "udp", secret = true, ttl = 86400, algorithm = "turn" },
     { type = "turns", host = "{{ vars.jitsi_domain }}", port = 5349, transport = "tcp", secret = true, ttl = 86400, algorithm = "turn" }
};

cross_domain_bosh = false;
consider_bosh_secure = true;
consider_websocket_secure = true;
-- https_ports = { }; -- Remove this line to prevent listening on port 5284

-- by default prosody 0.12 sends cors headers, if you want to disable it uncomment the following (the config is available on 0.12.1)
--http_cors_override = {
--    bosh = {
--        enabled = false;
--    };
--    websocket = {
--        enabled = false;
--    };
--}

-- https://ssl-config.mozilla.org/#server=haproxy&version=2.1&config=intermediate&openssl=1.1.0g&guideline=5.4
ssl = {
    protocol = "tlsv1_2+";
    ciphers = "ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:DHE-RSA-AES128-GCM-SHA256:DHE-RSA-AES256-GCM-SHA384"
}

unlimited_jids = {
    "focus@auth.{{ vars.jitsi_domain }}",
    "jvb@auth.{{ vars.jitsi_domain }}"
}

-- https://prosody.im/doc/modules/mod_smacks
smacks_max_unacked_stanzas = 5;
smacks_hibernation_time = 60;
smacks_max_old_sessions = 1;

VirtualHost "{{ vars.jitsi_domain }}"
    authentication = "jitsi-anonymous" -- do not delete me
    -- Properties below are modified by jitsi-meet-tokens package config
    -- and authentication above is switched to "token"
    --app_id="example_app_id"
    --app_secret="example_app_secret"
    -- Assign this host a certificate for TLS, otherwise it would use the one
    -- set in the global section (if any).
    -- Note that old-style SSL on port 5223 only supports one certificate, and will always
    -- use the global one.
    ssl = {
        key = "/etc/prosody/certs/{{ vars.jitsi_domain }}.key";
        certificate = "/etc/prosody/certs/{{ vars.jitsi_domain }}.crt";
    }
    -- we need bosh
    modules_enabled = {
        "bosh";
        "websocket";
        "smacks";
        "ping"; -- Enable mod_ping
        "external_services";
        "features_identity";
        "conference_duration";
        "muc_lobby_rooms";
        "muc_breakout_rooms";
        -- Keeps client messages on the routes that the rooms control: a client
        -- can address a message to a MUC or to a component, not to the JID of
        -- an account.
        "filter_direct_messages";
    }
    c2s_require_encryption = false
    lobby_muc = "lobby.{{ vars.jitsi_domain }}"
    breakout_rooms_muc = "breakout.{{ vars.jitsi_domain }}"
    main_muc = "conference.{{ vars.jitsi_domain }}"
    -- muc_lobby_whitelist = { "recorder.{{ vars.jitsi_domain }}" } -- Here we can whitelist jibri to enter lobby enabled rooms
    admins = { "focus@auth.{{ vars.jitsi_domain }}" }

Component "conference.{{ vars.jitsi_domain }}" "muc"
    restrict_room_creation = true
    storage = "memory"
    modules_enabled = {
        "muc_hide_all";
        "muc_meeting_id";
        "muc_domain_mapper";
        --"token_verification";
        "muc_rate_limit";
        "muc_password_whitelist";
    }
    admins = { "focus@auth.{{ vars.jitsi_domain }}" }
    muc_password_whitelist = {
        "focus@auth.{{ vars.jitsi_domain }}"
    }
    muc_room_locking = false
    muc_room_default_public_jids = true

Component "breakout.{{ vars.jitsi_domain }}" "muc"
    restrict_room_creation = true
    storage = "memory"
    modules_enabled = {
        "muc_hide_all";
        "muc_meeting_id";
        "muc_domain_mapper";
        "muc_rate_limit";
        --"polls";
    }
    admins = { "focus@auth.{{ vars.jitsi_domain }}" }
    muc_room_locking = false
    muc_room_default_public_jids = true

-- internal muc component
Component "internal.auth.{{ vars.jitsi_domain }}" "muc"
    storage = "memory"
    modules_enabled = {
        "muc_hide_all";
        "muc_filter_access";
        "ping";
    }
    -- Only accounts on the auth domain (jicofo, jvb, jibri, jigasi) can create or join rooms here.
    muc_filter_whitelist = { "auth.{{ vars.jitsi_domain }}" }
    admins = { "focus@auth.{{ vars.jitsi_domain }}", "jvb@auth.{{ vars.jitsi_domain }}" }
    muc_room_locking = false
    muc_room_default_public_jids = true

VirtualHost "auth.{{ vars.jitsi_domain }}"
    modules_enabled = {
        "limits_exception";
        "smacks";
    }
    authentication = "internal_hashed"
    smacks_hibernation_time = 15;

VirtualHost "recorder.{{ vars.jitsi_domain }}"
    modules_enabled = {
      "smacks";
    }
    authentication = "internal_hashed"
    smacks_max_old_sessions = 2000;

-- Proxy to jicofo's user JID, so that it doesn't have to register as a component.
Component "focus.{{ vars.jitsi_domain }}" "client_proxy"
    target_address = "focus@auth.{{ vars.jitsi_domain }}"

Component "speakerstats.{{ vars.jitsi_domain }}" "speakerstats_component"
    muc_component = "conference.{{ vars.jitsi_domain }}"

Component "endconference.{{ vars.jitsi_domain }}" "end_conference"
    muc_component = "conference.{{ vars.jitsi_domain }}"

Component "avmoderation.{{ vars.jitsi_domain }}" "av_moderation_component"
    muc_component = "conference.{{ vars.jitsi_domain }}"

Component "filesharing.{{ vars.jitsi_domain }}" "filesharing_component"
    muc_component = "conference.{{ vars.jitsi_domain }}"

Component "lobby.{{ vars.jitsi_domain }}" "muc"
    storage = "memory"
    restrict_room_creation = true
    muc_room_locking = false
    muc_room_default_public_jids = true
    modules_enabled = {
        "muc_hide_all";
        "muc_rate_limit";
    }

Component "metadata.{{ vars.jitsi_domain }}" "room_metadata_component"
    muc_component = "conference.{{ vars.jitsi_domain }}"
    breakout_rooms_component = "breakout.{{ vars.jitsi_domain }}"

Component "polls.{{ vars.jitsi_domain }}" "polls_component"
