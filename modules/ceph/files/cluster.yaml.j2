# Buckle (modules/ceph): the cluster's orchestrator specs, applied with
# `ceph orch apply -i` whenever this file changes. cephadm does the rest
# (placing, starting, restarting daemons). Removing a service here does not
# remove it from the cluster: `ceph orch rm <service>` does.
{%- for name, ip in vars.ceph_hosts | items %}
---
service_type: host
hostname: {{ name }}
addr: {{ name }}.{{ vars.tailnet }}
labels: [_admin, mon, mgr, osd]
{%- endfor %}
---
# One mon per host, at its tailnet address (host:ip sets the mon's public addr).
service_type: mon
placement:
  hosts:
{%- for name, ip in vars.ceph_hosts | items %}
    - '{{ name }}:{{ ip }}'
{%- endfor %}
---
# A mgr on every host: one active, the others standby. Each serves the
# prometheus module on :9283 (standbys answer with an error, see ceph_config),
# so every host's Alloy scrapes its own and exactly one returns metrics.
service_type: mgr
placement:
  label: mgr
---
# Per-daemon performance counters (OSD latencies, RGW requests) for the
# dashboards; the mgr's prometheus module leaves them out since Reef.
service_type: ceph-exporter
placement:
  host_pattern: '*'
---
# The LV modules/ceph made on each host's nvme0n1p3 (ceph-volume refuses
# partitions, not LVs).
service_type: osd
service_id: nvme
placement:
  label: osd
spec:
  data_devices:
    paths:
      - /dev/{{ vars.ceph_osd_vg }}/{{ vars.ceph_osd_lv }}
{%- if vars.ceph_rgw_hosts %}
---
service_type: rgw
service_id: s3
placement:
  hosts:
{%- for name in vars.ceph_rgw_hosts %}
    - {{ name }}
{%- endfor %}
spec:
  rgw_frontend_port: {{ vars.ceph_rgw_port }}
{%- endif %}
