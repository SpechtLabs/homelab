# {{ buckle_managed }}
# ptp4l as a slave of timepi's grandmaster (modules/ptp-server). It only
# steers {{ host.facts.script.ptp.interface }}'s hardware clock; chrony disciplines the system clock from it
# (refclock PHC in chrony.conf).
[global]
slaveOnly		1
domainNumber		0
network_transport	UDPv4
delay_mechanism		E2E
# Delay_Req by unicast to the grandmaster (it answers by multicast as before).
# Multicast ones reach every client, and a NIC that latches one receive
# timestamp at a time (isa's I219) then misses Syncs: "received SYNC without
# timestamp", rms ~700 ns instead of ~130.
hybrid_e2e		1
time_stamping		hardware
{% if "pi5" in host.groups %}
# The Pi 5's Ethernet (macb) can only timestamp all received packets or none.
hwts_filter		full
{% endif %}
# The CM4's PHY delivers transmit timestamps slower than ptp4l's 1 ms default.
tx_timestamp_timeout	50
tsproc_mode		filter
delay_filter		moving_median
delay_filter_length	10
clock_servo		pi
# Only the PHC steps (on start or after a long outage); the system clock is chrony's.
step_threshold		1.0
logging_level		6
# To stdout, which systemd puts in the journal. Not syslog: under its unit's
# sandbox, Ubuntu's AppArmor profile refuses /dev/log ("disconnected path").
use_syslog		0
verbose			1
summary_interval	6
