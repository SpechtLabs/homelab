# {{ buckle_managed }}
MONITOR {{ vars.nut_ups_name }}@{{ vars.nut_upstream_host }} 1 {{ vars.nut_upstream_user }} {{ secrets.NUT_UPSTREAM_PASSWORD }} secondary
MINSUPPLIES 1
SHUTDOWNCMD "/sbin/shutdown -h +0"
POLLFREQ 5
POLLFREQALERT 5
HOSTSYNC 15
DEADTIME 15
POWERDOWNFLAG /etc/killpower
RBWARNTIME 43200
NOCOMMWARNTIME 300
FINALDELAY {{ vars.nut_finaldelay }}
NOTIFYFLAG FSD SYSLOG+EXEC
