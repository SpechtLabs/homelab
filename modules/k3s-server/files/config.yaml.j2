# {{ buckle_managed }}
token: "{{ secrets.K3S_TOKEN }}"
data-dir: /var/lib/rancher/k3s
# labk3s runs over the tailnet: the node's address and flannel's VXLAN use the
# node's tailnet IPv4 (ips[0]; tailscale/policy.hujson, tag:k3s-node). The API
# is advertised at svc:{{ vars.k3s_service }}'s address: it becomes the
# `kubernetes` endpoint, so the agents' load balancers and pods calling
# kubernetes.default reach the API through the Service, never the node.
node-ip: {{ host.facts.tailscale.ips[0] }}
advertise-address: {{ vars.k3s_service_ip }}
flannel-iface: tailscale0
tls-san:
  - {{ vars.k3s_service }}.{{ vars.tailnet }}
{%- if vars.k3s_disable %}
disable:
{%- for component in vars.k3s_disable %}
  - {{ component }}
{%- endfor %}
{%- endif %}
disable-network-policy: {{ vars.k3s_disable_network_policy | lower }}
