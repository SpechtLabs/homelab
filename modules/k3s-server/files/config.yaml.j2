# {{ buckle_managed }}
token: "{{ secrets.K3S_TOKEN }}"
data-dir: /var/lib/rancher/k3s
# labk3s runs over the tailnet: the node's address, the API endpoint the
# agents learn, and flannel's VXLAN all use the tailnet (tailscale/policy.hujson,
# tag:k3s-node). ips[0] is the node's tailnet IPv4.
node-ip: {{ host.facts.tailscale.ips[0] }}
advertise-address: {{ host.facts.tailscale.ips[0] }}
flannel-iface: tailscale0
tls-san:
  - {{ vars.k3s_service }}.{{ vars.tailnet }}
{%- if vars.k3s_disable %}
disable:
{%- for component in vars.k3s_disable %}
  - {{ component }}
{%- endfor %}
{%- endif %}
disable-network-policy: {{ vars.k3s_disable_network_policy | lower }}
