# Managed by Buckle. Local changes will be overwritten.
# Settings live in /etc/rancher/k3s/config.yaml.
[Unit]
Description=Lightweight Kubernetes
Documentation=https://k3s.io
Wants=network-online.target tailscaled.service
After=network-online.target tailscaled.service

[Install]
WantedBy=multi-user.target

[Service]
Type=notify
EnvironmentFile=-/etc/default/%N
KillMode=process
Delegate=yes
LimitNOFILE=1048576
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
TimeoutStartSec=0
Restart=always
RestartSec=5s
# k3s runs over the tailnet (node-ip, flannel-iface: tailscale0): wait up to
# 2 minutes for tailscale0 to have its tailnet IPv4.
ExecStartPre=/usr/bin/timeout 120 /bin/sh -c 'until ip -4 -o addr show dev tailscale0 2>/dev/null | grep -q " 100\\."; do sleep 1; done'
ExecStartPre=-/sbin/modprobe br_netfilter
ExecStartPre=-/sbin/modprobe overlay
ExecStart=/usr/local/bin/k3s server
