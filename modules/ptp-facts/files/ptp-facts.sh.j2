#!/bin/sh
# {{ buckle_managed }}
# Buckle fact provider, mounted at host.facts.script.ptp. Whether the NIC that
# reaches timepi ({{ vars.ntp_server }}) can be a PTP client with hardware
# timestamps, which decides the ptp-client group (buckle.yaml):
#   interface: the NIC the route to timepi leaves by ("" without a route)
#   phc:       index of its PTP hardware clock, /dev/ptp<phc> (null if none)
#   hardware:  true if it timestamps in hardware both ways and has that clock
# ethtool asks the driver (or, on the CM4 blades, the PHY) for its timestamping
# capabilities: sysfs can't tell, the Pi 5's and the PHY's clocks don't hang
# off the netdev.
dev=$(ip -o route get {{ vars.ntp_server }} 2>/dev/null | sed -n 's/.* dev \([^ ]*\).*/\1/p')
ts=$( [ -n "$dev" ] && ethtool -T "$dev" 2>/dev/null)
# ethtool 6.1 (Debian 12) says "PTP Hardware Clock: 0", newer ones
# "Hardware timestamp provider index: 0"; "none" or -1 without a clock.
phc=$(printf '%s\n' "$ts" | sed -n -e 's/^PTP Hardware Clock: *\([0-9][0-9]*\)$/\1/p' \
  -e 's/^Hardware timestamp provider index: *\([0-9][0-9]*\)$/\1/p' | head -n 1)
hardware=false
if [ -n "$phc" ] && [ -c "/dev/ptp$phc" ]; then
  hardware=true
  for cap in hardware-transmit hardware-receive hardware-raw-clock; do
    printf '%s\n' "$ts" | grep -qw -- "$cap" || hardware=false
  done
fi
printf '{"interface":"%s","phc":%s,"hardware":%s}\n' "$dev" "${phc:-null}" "$hardware"
