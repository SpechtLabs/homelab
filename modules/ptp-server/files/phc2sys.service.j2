# {{ buckle_managed }}
[Unit]
Description=Synchronize system clock or PTP hardware clock (PHC)
Documentation=man:phc2sys
Requires=ptp4l@{{ vars.ptp_interface }}.service
After=ptp4l@{{ vars.ptp_interface }}.service
Before=time-sync.target

[Service]
Type=simple
ExecStart=/usr/sbin/phc2sys -w -c {{ vars.ptp_interface }} -s CLOCK_REALTIME
# Exits if eth0's hardware clock isn't there yet (early boot): retry.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
