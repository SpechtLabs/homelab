# {{ buckle_managed }}
# /etc/ntpsec/ntp.conf: GPS PPS through gpsd (SHM 1), with the public pool as
# a fallback. See ntp.conf(5).

driftfile /var/lib/ntpsec/ntp.drift
leapfile /usr/share/zoneinfo/leap-seconds.list

tos maxclock 11
tos minclock 1 minsane 1

pool 0.pool.ntp.org iburst
pool 1.pool.ntp.org iburst
pool 2.pool.ntp.org iburst

# Serve time to everyone, allow no configuration.
restrict default kod nomodify nopeer noquery limited
# The LAN's chrony clients poll every 2-8 s (modules/time-sync): no rate limit
# (`limited` would answer them with kiss-o'-death packets).
restrict 192.168.0.0 mask 255.255.255.0 nomodify nopeer noquery
restrict 127.0.0.1
restrict ::1

# gpsd NMEA time (SHM 0): numbers the PPS seconds inside gpsd. Its arrival
# wanders with the 9600-baud sentence load (150-600 ms seen), so it is never
# selected; time1 only keeps its ntpq offset readable.
server 127.127.28.0 minpoll 4 maxpoll 4 noselect
fudge 127.127.28.0 time1 {{ vars.ntp_gps_offset }} refid GPS

# gpsd PPS (SHM 1): each PPS edge, numbered by the NMEA second (which only has
# to be right to +-0.5 s). The clock ntpsec follows.
server 127.127.28.1 minpoll 4 maxpoll 4 prefer
fudge 127.127.28.1 refid PPS
