# {{ buckle_managed }}
# /etc/ntpsec/ntp.conf: GPS (gpsd SHM) and PPS refclocks, with the public pool
# as a fallback. See ntp.conf(5).

driftfile /var/lib/ntpsec/ntp.drift
leapfile /usr/share/zoneinfo/leap-seconds.list

tos maxclock 11
tos minclock 1 minsane 1

pool 0.pool.ntp.org iburst
pool 1.pool.ntp.org iburst
pool 2.pool.ntp.org iburst

# Serve time to everyone, allow no configuration.
restrict default kod nomodify nopeer noquery limited
restrict 127.0.0.1
restrict ::1

# pps-gpio /dev/pps0
server 127.127.22.0 minpoll 4 maxpoll 4
fudge 127.127.22.0 refid PPS

# gpsd clock via shared memory
server 127.127.28.0 minpoll 4 maxpoll 4 prefer
fudge 127.127.28.0 time1 {{ vars.ntp_gps_offset }} refid GPS flag1 1
