// Homelab tailnet (sphinx-map.ts.net). Rendered by Backstage from 63 Tailscale
// entities and the catalog's users and groups; change those, not this file.
// https://backstage.k8s.specht-labs.de/catalog/default/tailscale/sphinx-map
{
	"groups": {
		// Tailnet admins
		"group:admins": [
			"cedi@github",
		],
		// Home Assistant users
		"group:hass-users": [
			"x545vpxsbj@privaterelay.appleid.com",
			"cedi@github",
		],
		// Tailnet SREs
		"group:sre": [
			"cedi@github",
		],
		// Synology users
		"group:synology-users": [
			"x545vpxsbj@privaterelay.appleid.com",
			"cedi@github",
			"x1bay@github",
		],
		// Tailnet VPN users
		"group:vpn": [
			"x545vpxsbj@privaterelay.appleid.com",
			"cedi@github",
			"x1bay@github",
		],
	},

	"hosts": {
		"nas-elbschloss":   "100.71.201.45",
		"clusterpi-leader": "100.92.89.43",
		"hass-elbschloss":  "100.75.135.70",
		"nuc":              "100.122.149.90",
		"idp":              "100.77.112.23",
		"hass-schiltach":   "100.89.41.43",
	},

	"tagOwners": {
		// Backstage's egress proxies
		// Backstage on specht-labs, and its view onto the labk3s Argo CD.
		"tag:backstage": ["group:admins", "tag:k8s-operator"],
		// Buckle agents
		// Every host Buckle manages: they dial the server, and admins SSH to them.
		"tag:buckle-agent": ["group:admins"],
		// Buckle fleet server
		// Hosts svc:buckle.
		"tag:buckle-server": ["group:admins"],
		// Ceph cluster hosts
		// storagepi-ceph1..3: mons, OSDs, mgr, cephadm.
		"tag:ceph": ["group:admins"],
		// Ceph clients
		// The labk3s nodes, where ceph-csi maps RBD volumes.
		"tag:ceph-client": ["group:admins"],
		// Compute blades
		// blade-pi1..4.
		"tag:compute-blade": ["group:admins"],
		// Home Assistant at home
		// hass-elbschloss: hosts svc:hass. Its own tag because tag:smarthome is on
		// hass-schiltach too, which must not be able to serve svc:hass. The HA Tailscale
		// add-on advertises it (advertise_tags).
		"tag:hass-server": ["group:admins"],
		// Jumphost
		// Allowed to start Tailscale SSH sessions.
		"tag:jumphost": ["group:admins"],
		// Services the labk3s operator exposes
		"tag:k3s": ["tag:k3s-operator"],
		// labk3s nodes
		// clusterpi-leader and clusterpi-worker1..4: k3s runs over the tailnet.
		"tag:k3s-node": ["group:admins"],
		// Tailscale operator on labk3s
		"tag:k3s-operator": ["group:admins"],
		// labk3s's k3s server
		// clusterpi-leader: hosts svc:labk3s.
		"tag:k3s-server": ["group:admins"],
		// Services the specht-labs operator exposes
		"tag:k8s": ["tag:k8s-operator"],
		// Tailscale operator on specht-labs
		"tag:k8s-operator": ["group:admins"],
		// labk3s tailnet ingress
		// The tailnet-ingress ProxyGroup on labk3s: hosts svc:labk3s-argocd-api and
		// svc:lab-argocd. The operator owns it too: it mints the proxies' keys.
		"tag:labk3s-ingress": ["group:admins", "tag:k3s-operator"],
		// The Synology
		// Hosts svc:nas and svc:stream. Admins only, so neither k8s operator can hand it
		// to a proxy.
		"tag:nas": ["group:admins"],
		// The NUT server
		// isa: hosts svc:nut.
		"tag:nut-server": ["group:admins"],
		// Telemetry senders without a Buckle agent
		// meet and labk3s's lab-lgtm-egress: push to svc:lgtm. Home Assistant pushes as
		// tag:smarthome and doesn't need it.
		"tag:o11y-agent": ["group:admins"],
		// The o11y collector
		// isa: scrapes exporters, probes the SLO targets, pushes to svc:lgtm.
		"tag:o11y-collector": ["group:admins"],
		// Smart-home devices
		// The Home Assistant boxes: tighter access than other hosts.
		"tag:smarthome": ["group:admins"],
		// specht-labs tailnet ingress
		// The tailnet-ingress ProxyGroup on specht-labs: hosts svc:lgtm, svc:argocd and
		// svc:backstage.
		"tag:specht-labs-ingress": ["group:admins", "tag:k8s-operator"],
		// tailscale-k8s-auth
		// TKA's services: cluster sign-in through the tailnet.
		"tag:tka": ["tag:k8s-operator", "group:admins"],
		// tsidp, the tailnet's OIDC provider
		// Allowed to run tsidp with Tailscale Funnel.
		"tag:tsidp": ["group:admins"],
		// tsidp relying parties
		// Machines that call tsidp's token, JWKS and userinfo endpoints over the
		// tailnet: isa (the Buckle server), the NAS (DSM's SSO) and labk3s's
		// k3s-idp-egress (its Argo CD). Every consumesApis: api:tsidp-oidc across the
		// catalogs is one; the NAS lost DSM sign-in on 2026-11-25 when a retag dropped
		// this tag.
		"tag:tsidp-client": ["group:admins", "tag:k8s-operator", "tag:k3s-operator"],
	},

	"nodeAttrs": [
		// The k8s operators may enable Funnel
		{
			"target": ["tag:k8s-operator", "tag:k3s-operator"],
			"attr":   ["funnel"],
		},
		// tsidp may enable Funnel
		{
			"target": ["tag:tsidp"],
			"attr":   ["funnel"],
		},
		// VPN users get the Mullvad exit nodes
		{
			"target": ["group:vpn"],
			"attr":   ["mullvad"],
		},
	],

	"autoApprovers": {
		"services": {
			// The Buckle server serves svc:buckle
			// UI and API on tcp:443, the agents' gRPC on tcp:7700 with a PROXY v2 header
			// (fleet docs, reference: "Server and agents").
			"svc:buckle": ["tag:buckle-server"],
			// Home Assistant serves svc:hass
			// The add-on's `services:`: web UI on tcp:443 (HTTPS) and tcp:8123 (plain HTTP),
			// served by hass-elbschloss.
			"svc:hass": ["tag:hass-server"],
			// The k3s server serves svc:labk3s
			// The labk3s API (modules/k3s-server), tcp:6443 passed through to k3s.
			"svc:labk3s": ["tag:k3s-server"],
			// The labk3s ingress serves the labk3s Argo CD
			// The API (apps/argocd/cluster/labk3s/argocd-api-tailnet.yaml, tcp:443) and the
			// UI (Ingress argocd-server, https://lab-argocd.<tailnet>).
			"svc:labk3s-argocd-api": ["tag:labk3s-ingress"],
			"svc:lab-argocd": ["tag:labk3s-ingress"],
			// The NAS serves svc:nas, svc:stream, svc:node-exporter and svc:nfs
			// Jellyfin (`tailscale serve --service=svc:stream --https=443
			// http://localhost:8096`), DSM (tcp:443, tcp:5001) and Drive (tcp:6690)
			// (nas/README.md), the node_exporter (tcp:9100) and NFS v4.1 (tcp:2049).
			"svc:stream": ["tag:nas"],
			"svc:nas": ["tag:nas"],
			"svc:node-exporter": ["tag:nas"],
			"svc:nfs": ["tag:nas"],
			// isa serves svc:nut
			// upsd (modules/nut-server), the UPS for every Pi and the NUC.
			"svc:nut": ["tag:nut-server"],
			// The specht-labs tailnet Gateway serves LGTM, Argo CD and Backstage
			// k8s-deployment apps/envoy-gateway/cluster/specht-labs/tailnet-services.yaml.
			"svc:lgtm": ["tag:specht-labs-ingress"],
			"svc:argocd": ["tag:specht-labs-ingress"],
			"svc:backstage": ["tag:specht-labs-ingress"],
		},
	},

	"ssh": [
		// Admins SSH to every Buckle host
		// Admins and the jumphost, as any user but root.
		{
			"action": "accept",
			"src":    ["group:admins", "tag:jumphost"],
			"dst":    ["tag:buckle-agent"],
			"users":  ["autogroup:nonroot"],
		},
		// Admins are root on the Buckle hosts in check mode
		// isa, nuc, timepi, the jumphost, meet: root after a fresh sign-in, at most
		// every 8 hours.
		{
			"action":      "check",
			"checkPeriod": "8h",
			"src":         ["group:admins"],
			"dst":         ["tag:buckle-agent"],
			"users":       ["root"],
		},
		// Admins SSH to the Pi clusters and Home Assistant as anyone
		// Admins and the jumphost: the Ceph hosts, the labk3s nodes, the compute blades
		// and the Home Assistant boxes, as any user including root.
		{
			"action": "accept",
			"src":    ["group:admins", "tag:jumphost"],
			"dst":    ["tag:ceph", "tag:k3s-node", "tag:compute-blade", "tag:smarthome"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// Members SSH to their own devices
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot"],
		},
		// Members are root on their own devices in check mode
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["root"],
		},
		// SREs SSH to Ceph, the compute blades and labk3s
		{
			"action": "accept",
			"src":    ["group:sre"],
			"dst":    ["tag:ceph", "tag:compute-blade", "tag:k3s-node"],
			"users":  ["autogroup:nonroot"],
		},
		// SREs are root on Ceph, the compute blades and labk3s in check mode
		{
			"action":      "check",
			"checkPeriod": "8h",
			"src":         ["group:sre"],
			"dst":         ["tag:ceph", "tag:compute-blade", "tag:k3s-node"],
			"users":       ["root"],
		},
	],

	"grants": [
		// Admins reach everything
		{
			"src": ["group:admins"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		// Admins get cluster-admin through TKA
		// group:admins sign in to both clusters through TKA as cluster-admin, for an
		// hour at a time. Both instances (tka, lab-tka) listen on tcp:8123.
		{
			"src": ["group:admins"],
			"dst": ["tag:tka"],
			"ip": ["tcp:8123"],
			"app": {
				"specht-labs.de/cap/tka": [
					{
						"role":   "cluster-admin",
						"period": "1h",
					},
				],
			},
		},
		// Admins manage tsidp and administer Buckle
		// group:admins use tsidp's admin UI and register OIDC clients. Their tokens
		// carry groups ["buckle-admins"], which Buckle's admin_acl checks: who
		// administers the fleet is decided here.
		{
			"src": ["group:admins"],
			"dst": ["tag:tsidp"],
			"ip": ["tcp:443"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"allow_admin_ui": true,
						"allow_dcr": true,
						"extraClaims": {
							"groups": ["buckle-admins"],
						},
						"includeInUserInfo": true,
					},
				],
			},
		},
		// SREs sign in to Argo CD through tsidp
		{
			"src": ["group:sre"],
			"dst": ["tag:tsidp"],
			"ip": ["tcp:443"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"users":     ["group:sre"],
						"resources": ["argocd"],
					},
				],
			},
		},
		// Admins are Grafana admins
		// group:admins get groups ["grafana-admins"] in their tsidp tokens; Grafana maps
		// it to its Admin role. tsidp unions list claims across grants, so their tokens
		// carry ["buckle-admins", "grafana-admins"].
		{
			"src": ["group:admins"],
			"dst": ["tag:tsidp"],
			"ip": ["tcp:443"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"extraClaims": {
							"groups": ["grafana-admins"],
						},
						"includeInUserInfo": true,
					},
				],
			},
		},
		// Synology users sign in to the NAS through tsidp
		{
			"src": ["group:synology-users"],
			"dst": ["tag:tsidp"],
			"ip": ["tcp:443"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"users":     ["group:synology-users"],
						"resources": ["synology"],
					},
				],
			},
		},
		// VPN users use the exit nodes
		{
			"src": ["group:vpn"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
		// Admins edit everything in the smart-home devices' web UI
		{
			"src": ["group:admins"],
			"dst": ["tag:smarthome"],
			"ip": ["5252"],
			"app": {
				"tailscale.com/cap/webui": [
					{
						"canEdit": ["*"],
					},
				],
			},
		},
		// Members manage their own devices in the web UI
		// Account, SSH and exit node settings; not subnet routers.
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip": ["5252"],
			"app": {
				"tailscale.com/cap/webui": [
					{
						"canEdit": ["account", "ssh", "exitNodes"],
					},
				],
			},
		},
		// From the catalog: argocd-api
		// Used by group:admins (tailnet-allow).
		{
			"src": ["group:admins"],
			"dst": ["svc:argocd"],
			"ip":  ["tcp:443"],
		},
		// From the catalog: backstage-web
		// Used by group:admins (tailnet-allow).
		{
			"src": ["group:admins"],
			"dst": ["svc:backstage"],
			"ip":  ["tcp:443"],
		},
		// From the catalog: buckle-api
		// Used by group:admins, group:sre (tailnet-allow).
		{
			"src": ["group:admins", "group:sre"],
			"dst": ["svc:buckle"],
			"ip":  ["tcp:443"],
		},
		// From the catalog: buckle-agent-api
		// Consumed by buckle-agent.
		{
			"src": ["tag:buckle-agent"],
			"dst": ["svc:buckle"],
			"ip":  ["tcp:7700"],
		},
		// From the catalog: home-assistant-api
		// Consumed by o11y-collector. Used by group:hass-users (tailnet-allow).
		{
			"src": ["group:hass-users", "tag:o11y-collector"],
			"dst": ["svc:hass"],
			"ip":  ["tcp:443", "tcp:8123"],
		},
		// From the catalog: argocd-labk3s-web
		// Used by group:admins, group:sre (tailnet-allow).
		{
			"src": ["group:admins", "group:sre"],
			"dst": ["svc:lab-argocd"],
			"ip":  ["tcp:443"],
		},
		// From the catalog: labk3s-kubernetes-api
		// Consumed by k3s-agent, k3s-server, o11y-collector. Used by group:admins
		// (tailnet-allow).
		{
			"src": ["group:admins", "tag:k3s-node", "tag:o11y-collector"],
			"dst": ["svc:labk3s"],
			"ip":  ["tcp:6443"],
		},
		// From the catalog: argocd-labk3s-api
		// Consumed by backstage.
		{
			"src": ["tag:backstage"],
			"dst": ["svc:labk3s-argocd-api"],
			"ip":  ["tcp:443"],
		},
		// From the catalog: loki-push, mimir-remote-write, tempo-otlp
		// Consumed by alloy, grafana-k8s-monitoring-labk3s, home-assistant,
		// home-assistant-schiltach, o11y-collector.
		{
			"src": ["tag:buckle-agent", "tag:o11y-agent", "tag:o11y-collector", "tag:smarthome"],
			"dst": ["svc:lgtm"],
			"ip":  ["tcp:80"],
		},
		// From the catalog: synology-drive, synology-dsm-https
		// Used by group:synology-users (tailnet-allow).
		{
			"src": ["group:synology-users"],
			"dst": ["svc:nas"],
			"ip":  ["tcp:5001", "tcp:6690"],
		},
		// From the catalog: synology-dsm-web
		// Consumed by o11y-collector. Used by group:synology-users (tailnet-allow).
		{
			"src": ["group:synology-users", "tag:o11y-collector"],
			"dst": ["svc:nas"],
			"ip":  ["tcp:443"],
		},
		// From the catalog: nas-nfs
		// Consumed by nas-backup.
		{
			"src": ["tag:buckle-server", "tag:k3s-server"],
			"dst": ["svc:nfs"],
			"ip":  ["tcp:2049"],
		},
		// From the catalog: nas-node-exporter
		// Consumed by o11y-collector.
		{
			"src": ["tag:o11y-collector"],
			"dst": ["svc:node-exporter"],
			"ip":  ["tcp:9100"],
		},
		// From the catalog: nut
		// Consumed by nut-client.
		{
			"src": ["tag:buckle-agent"],
			"dst": ["svc:nut"],
			"ip":  ["tcp:3493"],
		},
		// From the catalog: jellyfin-web
		// Consumed by o11y-collector. Used by group:synology-users (tailnet-allow).
		{
			"src": ["group:synology-users", "tag:o11y-collector"],
			"dst": ["svc:stream"],
			"ip":  ["tcp:443"],
		},
		// From the catalog: ceph-cluster
		// Consumed by ceph.
		{
			"src": ["tag:ceph"],
			"dst": ["tag:ceph"],
			"ip":  ["tcp:2222", "tcp:3300", "tcp:6789", "tcp:6800-7479", "tcp:7481-7568"],
		},
		// From the catalog: ceph-rbd
		// Consumed by ceph-csi-rbd.
		{
			"src": ["tag:ceph-client"],
			"dst": ["tag:ceph"],
			"ip":  ["tcp:3300", "tcp:6789", "tcp:6800-7479", "tcp:7481-7568"],
		},
		// From the catalog: labk3s-node-mesh
		// Consumed by k3s-agent, k3s-server.
		{
			"src": ["tag:k3s-node"],
			"dst": ["tag:k3s-node"],
			"ip":  ["tcp:8681", "tcp:10250", "udp:8472"],
		},
		// From the catalog: tsidp-oidc
		// Consumed by argocd, argocd-labk3s, backstage, buckle-server, synology-dsm.
		// Used by autogroup:member (tailnet-allow).
		{
			"src": ["autogroup:member", "tag:tsidp-client"],
			"dst": ["tag:tsidp"],
			"ip":  ["tcp:443"],
		},
	],

	"tests": [
		// Admins reach the devices
		{
			"src":    "cedi@github",
			"proto":  "tcp",
			"accept": [
				"nas-elbschloss:5000",
				"clusterpi-leader:443",
				"clusterpi-leader:6443",
				"hass-elbschloss:8123",
				"nuc:1234",
				"idp:443",
				"hass-schiltach:8123",
			],
		},
		// Backstage reaches the labk3s Argo CD API and nothing else there
		{
			"src":   "tag:backstage",
			"proto": "tcp",
			"deny":  ["tag:k3s-node:443", "tag:k3s-server:6443", "nas-elbschloss:443"],
		},
		// Buckle agents reach the server only through svc:buckle
		{
			"src":   "tag:buckle-agent",
			"proto": "tcp",
			"deny":  ["tag:buckle-server:22", "tag:buckle-server:12345"],
		},
		{
			"src":   "tag:buckle-agent",
			"proto": "tcp",
			"deny":  ["tag:buckle-server:7700"],
		},
		// The backup hosts reach the NAS's NFS only through svc:nfs
		// isa (tag:buckle-server) and clusterpi-leader (tag:k3s-server) back up through
		// svc:nfs (modules/nas-backup); the NAS's own NFS, portmapper and mountd stay
		// closed to them.
		{
			"src":   "tag:buckle-server",
			"proto": "tcp",
			"deny":  ["nas-elbschloss:2049", "nas-elbschloss:111", "nas-elbschloss:892"],
		},
		{
			"src":   "tag:k3s-server",
			"proto": "tcp",
			"deny":  ["nas-elbschloss:2049", "nas-elbschloss:111", "nas-elbschloss:892"],
		},
		// Ceph's hosts and clients
		// The hosts reach each other including cephadm's sshd; clients get the mons and
		// OSDs, not cephadm, the dashboard or RGW.
		{
			"src":    "tag:ceph",
			"proto":  "tcp",
			"accept": [
				"tag:ceph:2222",
				"tag:ceph:3300",
				"tag:ceph:6789",
				"tag:ceph:6800",
				"tag:ceph:7568",
			],
		},
		{
			"src":    "tag:ceph-client",
			"proto":  "tcp",
			"accept": ["tag:ceph:3300", "tag:ceph:6789", "tag:ceph:6800", "tag:ceph:7568"],
			"deny":   ["tag:ceph:2222", "tag:ceph:8443", "tag:ceph:7480", "tag:ceph:9283"],
		},
		// The compute blades are neither Ceph clients nor labk3s nodes
		{
			"src":   "tag:compute-blade",
			"proto": "tcp",
			"deny":  ["tag:ceph:6789", "tag:k3s-node:10250", "tag:k3s-server:6443"],
		},
		// The labk3s nodes reach the API only through svc:labk3s
		{
			"src":    "tag:k3s-node",
			"proto":  "tcp",
			"accept": ["tag:k3s-node:10250", "tag:k3s-node:8681"],
			"deny":   ["tag:k3s-server:6443"],
		},
		// The NAS only through its Services
		// Synology users get DSM and Drive only through svc:nas and Home Assistant not
		// at all: nothing on the devices themselves. Buckle hosts and Home Assistant get
		// only their own ports on the NAS.
		{
			"src":   "x1bay@github",
			"proto": "tcp",
			"deny": [
				"hass-schiltach:8123",
				"nas-elbschloss:443",
				"nas-elbschloss:5001",
				"nas-elbschloss:6690",
				"nas-elbschloss:8096",
				"nas-elbschloss:5000",
				"nas-elbschloss:22",
				"nas-elbschloss:445",
				"hass-elbschloss:8123",
				"hass-elbschloss:22",
			],
		},
		{
			"src":   "group:synology-users",
			"proto": "tcp",
			"deny":  ["nas-elbschloss:443", "nas-elbschloss:5001", "nas-elbschloss:6690"],
		},
		{
			"src":   "tag:buckle-agent",
			"proto": "tcp",
			"deny": [
				"nas-elbschloss:443",
				"nas-elbschloss:445",
				"nas-elbschloss:5001",
				"nas-elbschloss:22",
				"nas-elbschloss:3493",
			],
		},
		{
			"src":   "tag:smarthome",
			"proto": "tcp",
			"deny":  ["nas-elbschloss:443", "nas-elbschloss:5001", "nas-elbschloss:22"],
		},
		{
			"src":   "tag:smarthome",
			"proto": "tcp",
			"deny":  ["nas-elbschloss:445", "nas-elbschloss:2049", "nas-elbschloss:6690"],
		},
		// NUT goes through svc:nut
		// The server's own address is closed to the clients.
		{
			"src":   "clusterpi-leader",
			"proto": "tcp",
			"deny":  ["tag:nut-server:3493"],
		},
		// The collector scrapes no device, and reaches the NAS and labk3s only through
		// their Services
		{
			"src":   "tag:o11y-collector",
			"proto": "tcp",
			"deny": [
				"tag:buckle-agent:9100",
				"tag:buckle-agent:5252",
				"tag:k3s-node:5252",
				"nas-elbschloss:9100",
				"nas-elbschloss:443",
				"tag:k3s-server:6443",
			],
		},
		// VPN users get the internet, not the homelab
		{
			"src":    "group:vpn",
			"proto":  "tcp",
			"accept": ["1.1.1.1:443"],
		},
		{
			"src":   "group:vpn",
			"proto": "tcp",
			"deny":  ["tag:buckle-agent:443", "tag:buckle-agent:80"],
		},
		{
			"src":   "group:vpn",
			"proto": "tcp",
			"deny":  ["tag:smarthome:8123"],
		},
	],

	"sshTests": [
		// cedi gets a shell on the nuc
		// As cedi directly, as root in check mode.
		{
			"src":    "cedi@github",
			"dst":    ["nuc"],
			"accept": ["cedi"],
		},
		{
			"src":    "cedi@github",
			"dst":    ["nuc"],
			"accept": ["cedi"],
			"check":  ["root"],
		},
	],
}
