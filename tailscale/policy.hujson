// This tailnet's policy is maintained in https://github.com/cedi/homelab/blob/main/tailscale/policy.hujson
// and applied by .github/workflows/tailscale.yaml. Edits in the admin console get overwritten.
{
	// Declare static groups of users beyond those in the identity service.
	"groups": {
		"group:admins": [
			"cedi@github",
		],
		"group:sre": [
			"cedi@github",
		],
		// group:vpn is given access to (mullvad) exit nodes
		"group:vpn": [
			"cedi@github",
			"x1bay@github",
			"x545vpxsbj@privaterelay.appleid.com",
		],
		// group:synology-users is given access to the Synology NAS
		"group:synology-users": [
			"cedi@github",
			"x1bay@github",
			"x545vpxsbj@privaterelay.appleid.com",
		],
	},

	// Declare convenient hostname aliases to use in place of IP addresses.
	"hosts": {
		"nas-elbschloss":      "100.71.201.45",
		"clusterpi-leader":    "100.92.89.43",
		"hass-elbschloss":     "100.75.135.70",
		"nuc":                 "100.122.149.90",
		"idp":                 "100.77.112.23",
		"hass-schiltach":      "100.89.41.43",
		"hole":                "100.65.216.48",
	},

	// Declare ACL-Tags and their owners
	"tagOwners": {
		"tag:core-infra":     ["group:admins"], // Devices tagged with tag:core-infra are critical services in the infrastructure that need to be treated more carefully and should not be as exposed
		"tag:core-services":  ["group:admins"], // Devices tagged with tag:core-services are the services that every user gets access to
		"tag:tsidp":          ["group:admins"], // Devices tagged with tag:tsidp are allowed to run tsidp with Tailscale Funnel
		"tag:smarthome":      ["group:admins"], // Devices tagged with tag:smarthome are smart-home devices with should be treated with tighter access controll restrictions
		"tag:k8s-operator":   ["group:admins"], // tag:k8s-operator is the tailscale operator running on my k8s clusters
		"tag:k3s-operator":   ["group:admins"], // tag:k8s-operator is the tailscale operator running on my k8s clusters
		"tag:k8s":            ["tag:k8s-operator"], // Devices tagged with tag:k8s are services exposed by the k8s-operator
		"tag:tka":            ["tag:k8s-operator", "group:admins"], // Devices tagged with tag:tka are tailscale-k8s-auth services exposed by tka
		"tag:k3s":            ["tag:k3s-operator"], // Devices tagged with tag:k8s are services exposed by the k8s-operator
		"tag:o11y-collector": ["group:admins"], // Devices tagged with tag:o11y-collector can scrape o11y data and send o11y it to o11y-endpoints
		"tag:o11y-agent":     ["group:admins"], // Devices tagged with tag:o11y-agent can send o11y data to o11y-endpoints
		"tag:o11y-endpoint":  ["group:admins", "tag:k8s-operator"], // Devices tagged with tag:o11y-endpoint accept o11y data send by o11-collector
		"tag:jumphost":       ["group:admins"], // Devices tagged with tag:jumphost are allowed to initiate SSH connections via tailscale-ssh
		"tag:homelab":        ["group:admins", "tag:k3s-operator"], // Devices tagged with tag:homelab should be considered as experimental devices running test workloads
		"tag:backstage":      ["group:admins", "tag:k8s-operator"], // Backstage's egress proxies on specht-labs (its view onto the labk3s ArgoCD)
		"tag:lab-argocd":     ["group:admins", "tag:k3s-operator"], // The labk3s ArgoCD API as a plain TCP device, for Backstage
		"tag:opencode":       ["group:admins"], // Devices tagged with tag:opencode are running the OpenCode Web UI
		"tag:buckle-server":  ["group:admins"], // Devices tagged with tag:buckle-server run the Buckle fleet server (github.com/cedi/homelab)
		// Service hosts: a tag that only the one host allowed to serve a Service
		// carries, for its autoApprovers. Owned by admins only, so neither k8s
		// operator can hand it to a proxy (tag:core-infra is on operator proxies).
		"tag:nas":            ["group:admins"], // The Synology: hosts svc:nas and svc:stream
		"tag:nut-server":     ["group:admins"], // The NUT server (isa): hosts svc:nut
	},

	"nodeAttrs": [
		// allow the k8s-operator to enable funnel
		{
			"target": ["tag:k8s-operator", "tag:k3s-operator"],
			"attr":   ["funnel"],
		},

		// allow tsidp to enable funnel
		{
			"target": ["tag:tsidp"],
			"attr":   ["funnel"],
		},

		// group:vpn has access to mullvad exit nodes
		{
			"target": ["group:vpn"],
			"attr":   ["mullvad"],
		},
	],
	// Tailscale Services (svc:<name>.<tailnet>) that tagged hosts may advertise
	// without approval in the admin console.
	"autoApprovers": {
		"services": {
			// Jellyfin on the NAS: `tailscale serve --service=svc:stream --https=443 http://localhost:8096`
			"svc:stream": ["tag:nas", "tag:core-infra"], // tag:core-infra until the host carries tag:nas
			// Buckle: UI and API on tcp:443, agents' gRPC on tcp:7700 with a PROXY v2
			// header (bootstrap/README.md).
			"svc:buckle": ["tag:buckle-server"],
			// Home Assistant's add-on (`services:` in its config): web UI on tcp:443
			// (HTTPS) and tcp:8123 (plain HTTP, as before the move to a Service).
			"svc:hass": ["tag:smarthome"],
			// DSM, Drive and SMB on the NAS (nas/README.md).
			"svc:nas": ["tag:nas", "tag:core-infra"], // tag:core-infra until the host carries tag:nas
			// upsd on isa (modules/nut-server), the UPS for every Pi and the NUC.
			"svc:nut": ["tag:nut-server", "tag:core-infra"], // tag:core-infra until the host carries tag:nut-server
		},
	},

	"ssh": [
		// admins can access the homelab unrestricted
		{
			"action": "accept",
			"src":    ["group:admins", "tag:jumphost"],
			"dst":    ["tag:homelab", "tag:smarthome"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// admins and jumphost can access the core-infra resources as nonroot
		{
			"action": "accept",
			"src":    ["group:admins", "tag:jumphost"],
			"dst":    ["tag:core-infra", "tag:core-services"],
			"users":  ["autogroup:nonroot"],
		},
		// admins can access the core-infra resources as root in check mode
		{
			"action":      "check",
			"checkPeriod": "8h",
			"src":         ["group:admins"],
			"dst":         ["tag:core-infra", "tag:core-services"],
			"users":       ["root"],
		},
		// any user can use Tailscale SSH to connect to their own devices as non-root user
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot"],
		},
		// any user can use Tailscale SSH to connect to their own devices in check mode as root user
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["root"],
		},
	],

	"grants": [
		// Allow admin to access everything unrestricted
		{
			"src":    ["group:admins"],
			"dst":    ["*"],
			"ip":     ["*"],
		},
		// Allow tag:o11y-collector and tag:o11y-agent to send metrics to tag:o11y-endpoint
		// Allow tag:smarthome to query from tag:o11y-endpoint
		{
			"src":    ["tag:o11y-collector", "tag:o11y-agent", "tag:smarthome"],
			"dst":    ["tag:o11y-endpoint"],
			"ip":     ["*"],
		},
		// Allow homelab to homelab
		{
			"src":    ["tag:homelab"],
			"dst":    ["tag:homelab"],
			"ip":     ["*"],
		},
		// Allow the homelab hosts' Alloy (modules/alloy in this repo) to push logs and
		// metrics to homelab-loki/homelab-mimir on the o11y endpoint, plain HTTP only.
		{
			"src":    ["tag:homelab"],
			"dst":    ["tag:o11y-endpoint"],
			"ip":     ["tcp:80"],
		},
		// Allow vpn members to access exit nodes
		{
			"src": ["group:vpn"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
		// Allow core-services to core-services
		{
			"src":  ["tag:core-services"],
			"dst":  ["tag:core-services"],
			"ip":   ["*"],
		},
		// Allow core-infra to core-infra
		{
			"src":    ["tag:core-infra"],
			"dst":    ["tag:core-infra"],
			"ip":  ["*"],
		},
		// The NUT clients (modules/nut-client: the Pis and the NUC) reach upsd
		// through svc:nut. It has only tcp:3493.
		{
			"src": ["tag:homelab", "tag:core-infra"],
			"dst": ["svc:nut"],
			"ip":  ["*"],
		},
		// Allow everyone to access core services
		{
			"src": ["autogroup:member", "autogroup:tagged"],
			"dst": ["tag:core-services"],
			"ip":  ["*"],
		},
		// Allow admins to access all tailscale web interfaces and edit everything
		{
			"src": ["group:admins"],
			"dst": ["tag:smarthome"],
			"ip":  ["5252"],
			"app": {
				"tailscale.com/cap/webui": [
					{
						"canEdit": ["*"], // can edit everything
					},
				],
			},
		},
		// Allow users to access the tailscale web interface for their own devices
		// and edit account, ssh and exitNode settings
		// does not allow configuring and setting up subnetRouters
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["5252"],
			"app": {
				"tailscale.com/cap/webui": [
					{
						"canEdit": ["account", "ssh", "exitNodes"], // can edit everything
					},
				],
			},
		},
		// Allow admins to use tka & connect via admin role
		{
			"src": ["group:admins"],
			"dst": ["tag:tka"],
			"ip":  ["*"],
			"app": {
				"specht-labs.de/cap/tka": [
					{
						"role": "cluster-admin",
						"period": "1h",
					},
				],
			},
		},
		// Backstage on specht-labs reads the labk3s ArgoCD API (read-only
		// account) through its egress proxy; nothing else on either side.
		{
			"src": ["tag:backstage"],
			"dst": ["tag:lab-argocd"],
			"ip":  ["tcp:443"],
		},
		// Allow tag:o11y-collector to scrape all prometheus endpoints
		{
			"src":    ["tag:o11y-collector"],
			"dst": ["*"],
			"ip": [
				"9100", // node-exporter
				"9243", // rpi-exporter
				"9116", // snmp-exporter
				"8123", // cadvisor
				"5252", // tailscale-exporter
				"9666", // compute-blade-agent
			],
		},
		// ...and to probe the services the homelab's availability SLOs measure
		// (vars/group-o11y-collector.yaml, o11y_probes), on the paths users take:
		// the k3s API like kubectl, Jellyfin through its Tailscale Service.
		{
			"src": ["tag:o11y-collector"],
			"dst": ["tag:homelab"],
			"ip":  ["tcp:6443"],
		},
		{
			"src": ["tag:o11y-collector"],
			"dst": ["svc:stream"],
			"ip":  ["tcp:443"],
		},
		// Synology users reach DSM and Drive through svc:nas (https://nas.<tailnet>).
		// The NAS is not in tag:core-services, so this is all they get. Jellyfin is
		// svc:stream. svc:nas also carries SMB (tcp:445) for Home Assistant's
		// backups, so these grants list ports instead of "*".
		{
			"src": ["group:synology-users"],
			"dst": ["svc:nas"],
			"ip":  [
				"tcp:443",  // DSM (https://nas.<tailnet>)
				"tcp:5001", // DSM HTTPS, which the Synology mobile apps use
				"tcp:6690", // Synology Drive sync
			],
		},
		// The same on the device itself, until no client dials nas-elbschloss
		// directly any more (it was `nas` until the svc:nas switch-over).
		{
			"src": ["group:synology-users"],
			"dst": ["nas-elbschloss"],
			"ip":  ["tcp:443", "tcp:5001", "tcp:6690"],
		},
		// The collector probes DSM for its availability SLO.
		{
			"src": ["tag:o11y-collector"],
			"dst": ["svc:nas"],
			"ip":  ["tcp:443"],
		},
		// Home Assistant (hass-elbschloss and hass-schiltach) writes its backups
		// to a share on the NAS: SMB through svc:nas, NFS on the device (NFS v3's
		// portmapper and mountd can't go through a Service).
		{
			"src": ["tag:smarthome"],
			"dst": ["svc:nas"],
			"ip":  ["tcp:445"],
		},
		{
			"src": ["tag:smarthome"],
			"dst": ["nas-elbschloss"],
			"ip":  ["tcp:445", "tcp:2049"],
		},
		// Home Assistant at home, https://hass.<tailnet> and http://hass.<tailnet>:8123,
		// for every member; the collector probes it for the availability SLO. The
		// Service has only the web UI's ports, so "*" is all it offers.
		// (Until hass-elbschloss leaves tag:core-services, that grant still opens
		// the device itself.)
		{
			"src": ["autogroup:member", "tag:o11y-collector"],
			"dst": ["svc:hass"],
			"ip":  ["*"],
		},
		// Synology users can stream from Jellyfin at https://stream.<tailnet>
		{
			"src": ["group:synology-users"],
			"dst": ["svc:stream"],
			"ip":  ["tcp:443"],
		},
		// Admins can manage tsidp and register OIDC clients. Their tokens carry
		// groups: ["buckle-admins"], which Buckle's admin_acl checks: who
		// administers the fleet is decided here, by group:admins.
		{
			"src": ["group:admins"],
			"dst": ["tag:tsidp"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"allow_admin_ui":    true,
						"allow_dcr":         true,
						"extraClaims":       {"groups": ["buckle-admins"]},
						"includeInUserInfo": true,
					},
				],
			},
		},
		// Admins get groups: ["grafana-admins"] in their tsidp tokens; Grafana maps it
		// to its Admin role. tsidp unions list claims across grants, so their tokens
		// carry ["buckle-admins", "grafana-admins"].
		{
			"src": ["group:admins"],
			"dst": ["tag:tsidp"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"extraClaims":       {"groups": ["grafana-admins"]},
						"includeInUserInfo": true,
					},
				],
			},
		},
		// Synology users can authenticate to Synology through tsidp.
		{
			"src": ["group:synology-users"],
			"dst": ["tag:tsidp"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"users":     ["group:synology-users"],
						"resources": ["synology"],
					},
				],
			},
		},
		// SRE users can authenticate to ArgoCD through tsidp.
		{
			"src": ["group:sre"],
			"dst": ["tag:tsidp"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"users":     ["group:sre"],
						"resources": ["argocd"],
					},
				],
			},
		},
		// Admins and SREs reach Buckle's UI and API at https://buckle.<tailnet>.
		// Signing in still needs the buckle-admins claim (server.yaml's user_acl).
		{
			"src": ["group:admins", "group:sre"],
			"dst": ["svc:buckle"],
			"ip":  ["tcp:443"],
		},
		// Buckle agents dial out to the server's gRPC port.
		// (Admins also reach the UI on nuc:7701 through the admin grant above.)
		{
			"src": ["tag:homelab", "tag:core-infra", "tag:core-services"],
			"dst": ["tag:buckle-server"],
			"ip":  ["tcp:7700"],
		},
		// ...or through svc:buckle, which forwards tcp:7700 to whichever host runs
		// the server with a PROXY v2 header (the server trusts it and whois-es the
		// agent's own address), so the server can move without touching agents.
		{
			"src": ["tag:homelab", "tag:core-infra", "tag:core-services"],
			"dst": ["svc:buckle"],
			"ip":  ["tcp:7700"],
		},
	],

	"tests": [
		{
			"src":   "cedi@github",
			"proto": "tcp",
			"accept": [
				"nas-elbschloss:5000",
				"clusterpi-leader:443",
				"clusterpi-leader:6443",
				"hass-elbschloss:8123",
				"nuc:1234",
				"idp:443",
				"hass-schiltach:8123",
			],
		},
		{
			"src":    "x1bay@github",
			"proto":  "tcp",
			"accept": ["nas-elbschloss:443", "nas-elbschloss:5001", "nas-elbschloss:6690", "hass-elbschloss:8123"],
			// Only DSM and Drive on the NAS: no Jellyfin port (svc:stream instead),
			// plain DSM, SSH or SMB.
			"deny":   ["hass-schiltach:8123", "nas-elbschloss:8096", "nas-elbschloss:5000", "nas-elbschloss:22", "nas-elbschloss:445"],
		},
		// Homelab boxes and Home Assistant get only their own ports on the NAS.
		{
			"src":    "tag:homelab",
			"proto":  "tcp",
			"deny":   ["nas-elbschloss:443", "nas-elbschloss:445", "nas-elbschloss:5001", "nas-elbschloss:22", "nas-elbschloss:3493"],
		},
		{
			"src":    "tag:smarthome",
			"proto":  "tcp",
			"deny":   ["nas-elbschloss:443", "nas-elbschloss:5001", "nas-elbschloss:22"],
		},
		// Backstage's egress reaches the labk3s ArgoCD API and nothing else there.
		{
			"src":    "tag:backstage",
			"proto":  "tcp",
			"accept": ["tag:lab-argocd:443"],
			"deny":   ["tag:lab-argocd:22", "tag:homelab:443", "nas-elbschloss:443"],
		},
		{
			"src":    "group:synology-users",
			"proto":  "tcp",
			"accept": ["nas-elbschloss:443", "nas-elbschloss:5001", "nas-elbschloss:6690"],
		},
		{
			"src":    "tag:smarthome",
			"proto":  "tcp",
			"accept": ["nas-elbschloss:445", "nas-elbschloss:2049"],
		},
		{
			"src":    "hass-schiltach",
			"proto":  "tcp",
			"accept": ["nas-elbschloss:445", "nas-elbschloss:2049"],
		},
		{
			"src":   "group:vpn",
			"proto": "tcp",
			"deny":  ["tag:homelab:443", "tag:homelab:80"],
		},
		{
			"src":    "tag:homelab",
			"proto":  "tcp",
			"accept": ["tag:o11y-endpoint:80"],
			"deny":   ["tag:o11y-endpoint:443", "tag:core-infra:22"],
		},
		{
			"src":    "group:vpn",
			"proto":  "tcp",
			"accept": ["1.1.1.1:443"],
		},
		{
			"src":    "tag:o11y-collector",
			"proto":  "tcp",
			"accept": ["tag:o11y-endpoint:443"],
		},
		{
			"src":    "tag:o11y-agent",
			"proto":  "tcp",
			"accept": ["tag:o11y-endpoint:443"],
		},
		{
			"src":    "tag:o11y-collector",
			"proto":  "tcp",
			"accept": ["tag:homelab:9100"],
		},
		{
			"src":   "tag:o11y-collector",
			"proto": "tcp",
			"deny":  ["tag:core-infra:443"],
		},
		{
			"src":   "group:vpn",
			"proto": "tcp",
			"deny":  ["tag:smarthome:8123"],
		},

		// NUT goes through svc:nut; the server's own address is closed to the clients.
		{
			"src":    "clusterpi-leader",
			"proto":  "tcp",
			"deny":   ["tag:core-infra:3493"],
		},
		// Buckle agents reach the server; nothing else is exposed to them.
		{
			"src":    "tag:homelab",
			"proto":  "tcp",
			"accept": ["tag:buckle-server:7700"],
		},
		{
			"src":    "tag:core-services",
			"proto":  "tcp",
			"accept": ["tag:buckle-server:7700"],
		},
	],

	"sshTests": [
		{
			"src":    "cedi@github",
			"dst":    ["nuc"],
			"accept": ["cedi"],
		},
		{
			"src":    "cedi@github",
			"dst":    ["nuc"],
			"accept": ["cedi"],
			"check":  ["root"],
		},
	],
}
