// This tailnet's policy is maintained in https://github.com/cedi/homelab/blob/main/tailscale/policy.hujson
// and applied by .github/workflows/tailscale.yaml. Edits in the admin console get overwritten.
{
	// Declare static groups of users beyond those in the identity service.
	"groups": {
		"group:admins": [
			"cedi@github",
		],
		"group:sre": [
			"cedi@github",
		],
		// group:vpn is given access to (mullvad) exit nodes
		"group:vpn": [
			"cedi@github",
			"x1bay@github",
			"x545vpxsbj@privaterelay.appleid.com",
		],
		// group:hass-users is given access to Home Assistant at home (svc:hass)
		"group:hass-users": [
			"cedi@github",
			"x545vpxsbj@privaterelay.appleid.com",
		],
		// group:synology-users is given access to the Synology NAS
		"group:synology-users": [
			"cedi@github",
			"x1bay@github",
			"x545vpxsbj@privaterelay.appleid.com",
		],
	},

	// Declare convenient hostname aliases to use in place of IP addresses.
	"hosts": {
		"nas-elbschloss":      "100.71.201.45",
		"clusterpi-leader":    "100.92.89.43",
		"hass-elbschloss":     "100.75.135.70",
		"nuc":                 "100.122.149.90",
		"idp":                 "100.77.112.23",
		"hass-schiltach":      "100.89.41.43",
	},

	// Declare ACL-Tags and their owners
	"tagOwners": {
		"tag:tsidp":          ["group:admins"], // Devices tagged with tag:tsidp are allowed to run tsidp with Tailscale Funnel
		"tag:smarthome":      ["group:admins"], // Devices tagged with tag:smarthome are smart-home devices with should be treated with tighter access controll restrictions
		"tag:k8s-operator":   ["group:admins"], // tag:k8s-operator is the tailscale operator running on my k8s clusters
		"tag:k3s-operator":   ["group:admins"], // tag:k8s-operator is the tailscale operator running on my k8s clusters
		"tag:k8s":            ["tag:k8s-operator"], // Devices tagged with tag:k8s are services exposed by the k8s-operator
		"tag:tka":            ["tag:k8s-operator", "group:admins"], // Devices tagged with tag:tka are tailscale-k8s-auth services exposed by tka
		"tag:k3s":            ["tag:k3s-operator"], // Devices tagged with tag:k8s are services exposed by the k8s-operator
		"tag:o11y-collector": ["group:admins"], // The o11y collector (isa): scrapes exporters, probes the SLO targets, pushes to svc:lgtm
		"tag:o11y-agent":     ["group:admins"], // Telemetry senders without a Buckle agent (meet, labk3s's lab-lgtm-egress): push to svc:lgtm
		"tag:jumphost":       ["group:admins"], // Devices tagged with tag:jumphost are allowed to initiate SSH connections via tailscale-ssh
		"tag:backstage":      ["group:admins", "tag:k8s-operator"], // Backstage's egress proxies on specht-labs (its view onto the labk3s ArgoCD)
		"tag:lab-argocd":     ["group:admins", "tag:k3s-operator"], // The labk3s ArgoCD API as a plain TCP device, for Backstage
		"tag:opencode":       ["group:admins"], // Devices tagged with tag:opencode are running the OpenCode Web UI
		"tag:buckle-server":  ["group:admins"], // Devices tagged with tag:buckle-server run the Buckle fleet server (github.com/cedi/homelab)
		"tag:buckle-agent":   ["group:admins"], // Devices tagged with tag:buckle-agent run a Buckle agent: they dial the server, and admins SSH to them
		"tag:ceph":           ["group:admins"], // Ceph cluster hosts (storagepi-ceph1..3): mons, OSDs, mgr, cephadm
		"tag:ceph-client":    ["group:admins"], // Ceph clients: the labk3s nodes, where ceph-csi maps RBD volumes
		"tag:compute-blade":  ["group:admins"], // The compute blades (blade-pi1..4)
		"tag:k3s-node":       ["group:admins"], // labk3s nodes (clusterpi-leader, clusterpi-worker1..4): k3s runs over the tailnet
		"tag:tsidp-client":   ["group:admins", "tag:k8s-operator", "tag:k3s-operator"],
		// Host tag owned by the operator too (it mints the proxies' keys), unlike
		// the admins-only host tags above.
		"tag:specht-labs-ingress": ["group:admins", "tag:k8s-operator"], // The tailnet-ingress ProxyGroup on specht-labs (k8s-deployment): hosts svc:lgtm, svc:argocd, svc:backstage // Machines that are tsidp relying parties (token, JWKS, userinfo calls): the Buckle server, the labk3s egress to idp
		// Service hosts: a tag that only the one host allowed to serve a Service
		// carries, for its autoApprovers. Owned by admins only, so neither k8s
		// operator can hand it to a proxy.
		"tag:nas":            ["group:admins"], // The Synology: hosts svc:nas and svc:stream
		"tag:nut-server":     ["group:admins"], // The NUT server (isa): hosts svc:nut
		"tag:k3s-server":     ["group:admins"], // labk3s's k3s server (clusterpi-leader): hosts svc:labk3s
	},

	"nodeAttrs": [
		// allow the k8s-operator to enable funnel
		{
			"target": ["tag:k8s-operator", "tag:k3s-operator"],
			"attr":   ["funnel"],
		},

		// allow tsidp to enable funnel
		{
			"target": ["tag:tsidp"],
			"attr":   ["funnel"],
		},

		// group:vpn has access to mullvad exit nodes
		{
			"target": ["group:vpn"],
			"attr":   ["mullvad"],
		},
	],
	// Tailscale Services (svc:<name>.<tailnet>) that tagged hosts may advertise
	// without approval in the admin console.
	"autoApprovers": {
		"services": {
			// Jellyfin on the NAS: `tailscale serve --service=svc:stream --https=443 http://localhost:8096`
			"svc:stream": ["tag:nas"],
			// Buckle: UI and API on tcp:443, agents' gRPC on tcp:7700 with a PROXY v2
			// header (bootstrap/README.md).
			"svc:buckle": ["tag:buckle-server"],
			// Home Assistant's add-on (`services:` in its config): web UI on tcp:443
			// (HTTPS) and tcp:8123 (plain HTTP, as before the move to a Service).
			"svc:hass": ["tag:smarthome"],
			// DSM, Drive and SMB on the NAS (nas/README.md).
			"svc:nas": ["tag:nas"],
			// upsd on isa (modules/nut-server), the UPS for every Pi and the NUC.
			"svc:nut": ["tag:nut-server"],
			// The labk3s API (modules/k3s-server), tcp:6443 passed through to k3s.
			"svc:labk3s": ["tag:k3s-server"],
			// The specht-labs tailnet Gateway (k8s-deployment
			// apps/envoy-gateway/cluster/specht-labs/tailnet-services.yaml).
			"svc:lgtm":      ["tag:specht-labs-ingress"],
			"svc:argocd":    ["tag:specht-labs-ingress"],
			"svc:backstage": ["tag:specht-labs-ingress"],
		},
	},

	"ssh": [
		// Admins and the jumphost: everything Buckle manages, the Home Assistant
		// boxes, the Ceph hosts, the labk3s nodes and the compute blades, as any
		// user; root on the Pi clusters and the Home Assistant boxes directly...
		{
			"action": "accept",
			"src":    ["group:admins", "tag:jumphost"],
			"dst":    ["tag:ceph", "tag:k3s-node", "tag:compute-blade", "tag:smarthome"],
			"users":  ["autogroup:nonroot", "root"],
		},
		{
			"action": "accept",
			"src":    ["group:admins", "tag:jumphost"],
			"dst":    ["tag:buckle-agent"],
			"users":  ["autogroup:nonroot"],
		},
		// ...and root on the rest of the Buckle hosts (isa, nuc, timepi, the
		// jumphost, meet) in check mode.
		{
			"action":      "check",
			"checkPeriod": "8h",
			"src":         ["group:admins"],
			"dst":         ["tag:buckle-agent"],
			"users":       ["root"],
		},
		// SREs: the Ceph hosts, the compute blades and the labk3s nodes, as any
		// user; root in check mode.
		{
			"action": "accept",
			"src":    ["group:sre"],
			"dst":    ["tag:ceph", "tag:compute-blade", "tag:k3s-node"],
			"users":  ["autogroup:nonroot"],
		},
		{
			"action":      "check",
			"checkPeriod": "8h",
			"src":         ["group:sre"],
			"dst":         ["tag:ceph", "tag:compute-blade", "tag:k3s-node"],
			"users":       ["root"],
		},
		// any user can use Tailscale SSH to connect to their own devices as non-root user
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot"],
		},
		// any user can use Tailscale SSH to connect to their own devices in check mode as root user
		{
			"action": "check",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["root"],
		},
	],

	"grants": [
		// Allow admin to access everything unrestricted
		{
			"src":    ["group:admins"],
			"dst":    ["*"],
			"ip":     ["*"],
		},
		// Ceph speaks only on the tailnet (public_network is 100.64.0.0/10,
		// modules/ceph): the hosts among themselves (cephadm's sshd on 2222, mons
		// on 3300/6789, OSDs and mgr on 6800-7568, ms_bind_port_max) and the
		// labk3s nodes' ceph-csi as clients. Node-scoped: clients reach every OSD
		// at its own address, so there's no Service in front. The OSD range skips
		// 7480, RGW's port (no consumer).
		{
			"src": ["tag:ceph"],
			"dst": ["tag:ceph"],
			"ip":  ["tcp:2222", "tcp:3300", "tcp:6789", "tcp:6800-7479", "tcp:7481-7568"],
		},
		{
			"src": ["tag:ceph-client"],
			"dst": ["tag:ceph"],
			"ip":  ["tcp:3300", "tcp:6789", "tcp:6800-7479", "tcp:7481-7568"],
		},
		// labk3s over the tailnet (node-ip and flannel on tailscale0): agents join
		// through svc:labk3s, then use the API endpoint Kubernetes advertises (the
		// server's own tailnet address); flannel's VXLAN, the kubelet API
		// (exec/logs, metrics-server, Alloy's scrapes) and ceph-csi's metrics run
		// node to node. Node-scoped like Ceph: every node is a peer.
		{
			"src": ["tag:k3s-node"],
			"dst": ["svc:labk3s"],
			"ip":  ["tcp:6443"],
		},
		{
			"src": ["tag:k3s-node"],
			"dst": ["tag:k3s-server"],
			"ip":  ["tcp:6443"],
		},
		{
			"src": ["tag:k3s-node"],
			"dst": ["tag:k3s-node"],
			"ip":  ["udp:8472", "tcp:10250", "tcp:8681"],
		},
		// LGTM push and query through svc:lgtm, plain HTTP (it has only tcp:80):
		// Alloy on the Buckle hosts, the collector, meet and labk3s's
		// lab-lgtm-egress (tag:o11y-agent), Home Assistant.
		{
			"src": ["tag:buckle-agent", "tag:o11y-collector", "tag:o11y-agent", "tag:smarthome"],
			"dst": ["svc:lgtm"],
			"ip":  ["tcp:80"],
		},
		// Argo CD and Backstage on specht-labs (argocd.k8s.specht-labs.de,
		// backstage.k8s.specht-labs.de); admins' "*" grant covers them too.
		{
			"src": ["group:admins"],
			"dst": ["svc:argocd", "svc:backstage"],
			"ip":  ["tcp:443"],
		},
		// Allow vpn members to access exit nodes
		{
			"src": ["group:vpn"],
			"dst": ["autogroup:internet"],
			"ip":  ["*"],
		},
		// The NUT clients (modules/nut-client: the Pis and the NUC, all Buckle
		// hosts) reach upsd through svc:nut. It has only tcp:3493.
		{
			"src": ["tag:buckle-agent"],
			"dst": ["svc:nut"],
			"ip":  ["tcp:3493"],
		},
		// Allow admins to access all tailscale web interfaces and edit everything
		{
			"src": ["group:admins"],
			"dst": ["tag:smarthome"],
			"ip":  ["5252"],
			"app": {
				"tailscale.com/cap/webui": [
					{
						"canEdit": ["*"], // can edit everything
					},
				],
			},
		},
		// Allow users to access the tailscale web interface for their own devices
		// and edit account, ssh and exitNode settings
		// does not allow configuring and setting up subnetRouters
		{
			"src": ["autogroup:member"],
			"dst": ["autogroup:self"],
			"ip":  ["5252"],
			"app": {
				"tailscale.com/cap/webui": [
					{
						"canEdit": ["account", "ssh", "exitNodes"], // can edit everything
					},
				],
			},
		},
		// Allow admins to use tka & connect via admin role
		{
			"src": ["group:admins"],
			"dst": ["tag:tka"],
			"ip":  ["*"],
			"app": {
				"specht-labs.de/cap/tka": [
					{
						"role": "cluster-admin",
						"period": "1h",
					},
				],
			},
		},
		// Backstage on specht-labs reads the labk3s ArgoCD API (read-only
		// account) through its egress proxy; nothing else on either side.
		{
			"src": ["tag:backstage"],
			"dst": ["tag:lab-argocd"],
			"ip":  ["tcp:443"],
		},
		// Allow tag:o11y-collector to scrape all prometheus endpoints
		{
			"src":    ["tag:o11y-collector"],
			"dst": ["*"],
			"ip": [
				"9100", // node-exporter
				"9243", // rpi-exporter
				"9116", // snmp-exporter
				"8123", // cadvisor
				"5252", // tailscale-exporter
				"9666", // compute-blade-agent
			],
		},
		// ...and to probe the services the homelab's availability SLOs measure
		// (vars/group-o11y-collector.yaml, o11y_probes), on the paths users take:
		// their Tailscale Services (svc:labk3s below, svc:hass, svc:nas).
		{
			"src": ["tag:o11y-collector"],
			"dst": ["svc:stream"],
			"ip":  ["tcp:443"],
		},
		// The labk3s API at https://labk3s.<tailnet>:6443: kubectl for admins, the
		// collector's probe. The Service has only tcp:6443.
		{
			"src": ["group:admins"],
			"dst": ["svc:labk3s"],
			"ip":  ["*"],
		},
		{
			"src": ["tag:o11y-collector"],
			"dst": ["svc:labk3s"],
			"ip":  ["tcp:6443"],
		},
		// Synology users reach DSM and Drive through svc:nas (https://nas.<tailnet>).
		// This is all they get on the NAS. Jellyfin is
		// svc:stream. svc:nas also carries SMB (tcp:445) for Home Assistant's
		// backups, so these grants list ports instead of "*".
		{
			"src": ["group:synology-users"],
			"dst": ["svc:nas"],
			"ip":  [
				"tcp:443",  // DSM (https://nas.<tailnet>)
				"tcp:5001", // DSM HTTPS, which the Synology mobile apps use
				"tcp:6690", // Synology Drive sync
			],
		},
		// The collector probes DSM for its availability SLO.
		{
			"src": ["tag:o11y-collector"],
			"dst": ["svc:nas"],
			"ip":  ["tcp:443"],
		},
		// Home Assistant has nothing on the NAS over the tailnet: hass-elbschloss
		// backs up through the Synology integration over the LAN, hass-schiltach
		// doesn't use the NAS (DSM's connection log and the backup folder, 2026-11-26).
		// Home Assistant at home, https://hass.<tailnet> and http://hass.<tailnet>:8123,
		// for group:hass-users; the collector probes it for the availability SLO.
		// The Service has only the web UI's ports, so "*" is all it offers.
		{
			"src": ["group:hass-users"],
			"dst": ["svc:hass"],
			"ip":  ["*"],
		},
		{
			"src": ["tag:o11y-collector"],
			"dst": ["svc:hass"],
			"ip":  ["tcp:443", "tcp:8123"],
		},
		// Synology users can stream from Jellyfin at https://stream.<tailnet>
		{
			"src": ["group:synology-users"],
			"dst": ["svc:stream"],
			"ip":  ["tcp:443"],
		},
		// Every member signs in through tsidp (https://idp.<tailnet>); the grants
		// below add capabilities per group. tsidp stays a device, not a Service:
		// it relies on Funnel and on capability grants matched on its own address.
		// Machines that are relying parties (tag:tsidp-client) and the collector's
		// probe reach it the same way.
		{
			"src": ["autogroup:member", "tag:tsidp-client", "tag:o11y-collector"],
			"dst": ["tag:tsidp"],
			"ip":  ["tcp:443"],
		},
		// The Buckle server's nightly backup goes to the NAS over NFS v3, which
		// can't go through a Service: portmapper, status, mountd, nfs, nlockmgr
		// (rpcinfo -p on the NAS). tag:nas is the NAS itself, the only device
		// carrying it.
		{
			"src": ["tag:buckle-server"],
			"dst": ["tag:nas"],
			"ip":  ["tcp:111", "tcp:662", "tcp:892", "tcp:2049", "tcp:4045"],
		},
		// Admins can manage tsidp and register OIDC clients. Their tokens carry
		// groups: ["buckle-admins"], which Buckle's admin_acl checks: who
		// administers the fleet is decided here, by group:admins.
		{
			"src": ["group:admins"],
			"dst": ["tag:tsidp"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"allow_admin_ui":    true,
						"allow_dcr":         true,
						"extraClaims":       {"groups": ["buckle-admins"]},
						"includeInUserInfo": true,
					},
				],
			},
		},
		// Admins get groups: ["grafana-admins"] in their tsidp tokens; Grafana maps it
		// to its Admin role. tsidp unions list claims across grants, so their tokens
		// carry ["buckle-admins", "grafana-admins"].
		{
			"src": ["group:admins"],
			"dst": ["tag:tsidp"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"extraClaims":       {"groups": ["grafana-admins"]},
						"includeInUserInfo": true,
					},
				],
			},
		},
		// Synology users can authenticate to Synology through tsidp.
		{
			"src": ["group:synology-users"],
			"dst": ["tag:tsidp"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"users":     ["group:synology-users"],
						"resources": ["synology"],
					},
				],
			},
		},
		// SRE users can authenticate to ArgoCD through tsidp.
		{
			"src": ["group:sre"],
			"dst": ["tag:tsidp"],
			"ip":  ["*"],
			"app": {
				"tailscale.com/cap/tsidp": [
					{
						"users":     ["group:sre"],
						"resources": ["argocd"],
					},
				],
			},
		},
		// Admins and SREs reach Buckle's UI and API at https://buckle.<tailnet>.
		// Signing in still needs the buckle-admins claim (server.yaml's user_acl).
		{
			"src": ["group:admins", "group:sre"],
			"dst": ["svc:buckle"],
			"ip":  ["tcp:443"],
		},
		// Buckle agents dial the server's gRPC port through svc:buckle, which
		// forwards tcp:7700 to whichever host runs the server with a PROXY v2
		// header (the server trusts it and whois-es the agent's own address), so
		// the server can move without touching agents.
		{
			"src": ["tag:buckle-agent"],
			"dst": ["svc:buckle"],
			"ip":  ["tcp:7700"],
		},
	],

	"tests": [
		{
			"src":   "cedi@github",
			"proto": "tcp",
			"accept": [
				"nas-elbschloss:5000",
				"clusterpi-leader:443",
				"clusterpi-leader:6443",
				"hass-elbschloss:8123",
				"nuc:1234",
				"idp:443",
				"hass-schiltach:8123",
			],
		},
		{
			"src":    "x1bay@github",
			"proto":  "tcp",
			// DSM and Drive only through svc:nas, Home Assistant not at all: nothing
			// on the devices themselves.
			"deny":   ["hass-schiltach:8123", "nas-elbschloss:443", "nas-elbschloss:5001", "nas-elbschloss:6690", "nas-elbschloss:8096", "nas-elbschloss:5000", "nas-elbschloss:22", "nas-elbschloss:445", "hass-elbschloss:8123", "hass-elbschloss:22"],
		},
		// Buckle hosts and Home Assistant get only their own ports on the NAS.
		{
			"src":    "tag:buckle-agent",
			"proto":  "tcp",
			"deny":   ["nas-elbschloss:443", "nas-elbschloss:445", "nas-elbschloss:5001", "nas-elbschloss:22", "nas-elbschloss:3493"],
		},
		{
			"src":    "tag:smarthome",
			"proto":  "tcp",
			"deny":   ["nas-elbschloss:443", "nas-elbschloss:5001", "nas-elbschloss:22"],
		},
		// Backstage's egress reaches the labk3s ArgoCD API and nothing else there.
		{
			"src":    "tag:backstage",
			"proto":  "tcp",
			"accept": ["tag:lab-argocd:443"],
			"deny":   ["tag:lab-argocd:22", "tag:k3s-node:443", "nas-elbschloss:443"],
		},
		{
			"src":    "group:synology-users",
			"proto":  "tcp",
			"deny":   ["nas-elbschloss:443", "nas-elbschloss:5001", "nas-elbschloss:6690"],
		},
		{
			"src":    "tag:smarthome",
			"proto":  "tcp",
			"deny":   ["nas-elbschloss:445", "nas-elbschloss:2049", "nas-elbschloss:6690"],
		},
		{
			"src":   "group:vpn",
			"proto": "tcp",
			"deny":  ["tag:buckle-agent:443", "tag:buckle-agent:80"],
		},
		{
			"src":    "tag:buckle-agent",
			"proto":  "tcp",
			"deny":   ["tag:buckle-server:22", "tag:buckle-server:12345"],
		},
		// The compute blades are neither Ceph clients nor labk3s nodes.
		{
			"src":    "tag:compute-blade",
			"proto":  "tcp",
			"deny":   ["tag:ceph:6789", "tag:k3s-node:10250", "tag:k3s-server:6443"],
		},
		// Ceph: the hosts reach each other including cephadm's sshd; clients
		// get the mons and OSDs, not cephadm, the dashboard or RGW.
		{
			"src":    "tag:ceph",
			"proto":  "tcp",
			"accept": ["tag:ceph:2222", "tag:ceph:3300", "tag:ceph:6789", "tag:ceph:6800", "tag:ceph:7568"],
		},
		{
			"src":    "tag:ceph-client",
			"proto":  "tcp",
			"accept": ["tag:ceph:3300", "tag:ceph:6789", "tag:ceph:6800", "tag:ceph:7568"],
			"deny":   ["tag:ceph:2222", "tag:ceph:8443", "tag:ceph:7480", "tag:ceph:9283"],
		},
		{
			"src":    "group:vpn",
			"proto":  "tcp",
			"accept": ["1.1.1.1:443"],
		},
		{
			"src":    "tag:o11y-collector",
			"proto":  "tcp",
			"accept": ["tag:buckle-agent:9100"],
		},
		{
			"src":   "tag:o11y-collector",
			"proto": "tcp",
			"deny":  ["nas-elbschloss:443", "tag:k3s-server:6443"],
		},
		{
			"src":   "group:vpn",
			"proto": "tcp",
			"deny":  ["tag:smarthome:8123"],
		},

		// NUT goes through svc:nut; the server's own address is closed to the clients.
		{
			"src":    "clusterpi-leader",
			"proto":  "tcp",
			"deny":   ["tag:nut-server:3493"],
		},
		// Buckle agents reach the server through svc:buckle only, not on its own address.
		{
			"src":    "tag:buckle-agent",
			"proto":  "tcp",
			"deny":   ["tag:buckle-server:7700"],
		},
	],

	"sshTests": [
		{
			"src":    "cedi@github",
			"dst":    ["nuc"],
			"accept": ["cedi"],
		},
		{
			"src":    "cedi@github",
			"dst":    ["nuc"],
			"accept": ["cedi"],
			"check":  ["root"],
		},
	],
}
