{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned in Buckle vars, marked with a renovate comment",
      "managerFilePatterns": [
        "/^vars/.+\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?\\n\\w+: (?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "Git commits pinned in Buckle vars (follows a branch, updates the digest)",
      "managerFilePatterns": [
        "/^vars/.+\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>git-refs) depName=(?<depName>\\S+) branch=(?<currentValue>\\S+)\\n\\w+: (?<currentDigest>[0-9a-f]{40})"
      ]
    },
    {
      "customType": "regex",
      "description": "The buckle CLI pinned for local use and CI",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "\"github:SierraSoftworks/buckle\" = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "SierraSoftworks/buckle",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "bladectl (compute-blade-agent's CLI) pinned for local use",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "\"github:compute-blade-community/compute-blade-agent\" = \"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "compute-blade-community/compute-blade-agent",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "k3s: one minor at a time, never automerge",
      "matchDepNames": [
        "k3s-io/k3s"
      ],
      "separateMinorPatch": true,
      "separateMultipleMinor": true,
      "automerge": false,
      "versioning": "regex:^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)\\+k3s(?<build>\\d+)$"
    },
    {
      "description": "Buckle: CLI and fleet in one PR; majors by hand (server first, check the release notes)",
      "matchDepNames": [
        "SierraSoftworks/buckle"
      ],
      "groupName": "buckle",
      "major": {
        "enabled": false
      }
    },
    {
      "description": "compute-blade-agent: agent on the blades and bladectl here in one PR",
      "matchDepNames": [
        "compute-blade-community/compute-blade-agent"
      ],
      "groupName": "compute-blade-agent"
    }
  ]
}
