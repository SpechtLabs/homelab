# /etc/systemd/system/buckle-server.service on the NUC.
[Unit]
Description=Buckle fleet server
Documentation=https://buckle.sierrasoftworks.com
After=network-online.target tailscaled.service
Wants=network-online.target
Requires=tailscaled.service

[Service]
EnvironmentFile=/etc/buckle/server.env
ExecStart=/usr/local/bin/buckle server --config /etc/buckle/server.yaml
Restart=on-failure
RestartSec=5s
StateDirectory=buckle-server
StateDirectoryMode=0700

[Install]
WantedBy=multi-user.target
