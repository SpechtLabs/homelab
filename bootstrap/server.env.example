# /etc/buckle/server.env (mode 0600). Never commit the real one.
BUCKLE_LISTEN_ADDR=100.x.y.z          # `tailscale ip -4` on the server host (isa)
OIDC_CLIENT_ID=...                    # tsidp client "buckle" (dynamic registration)
OIDC_CLIENT_SECRET=...
# Only once the matching server.yaml sections are uncommented:
# GIT_TOKEN=github_pat_...            # if the repo goes private
# TS_OAUTH_CLIENT_ID=...
# TS_OAUTH_CLIENT_SECRET=tskey-client-...
